apiVersion: v1
kind: ConfigMap
metadata:
  name: kong-declarative
  namespace: sas47-kong
data:
  kong.yml: |
    _format_version: "3.0"
    _transform: true
    services:
      - name: standard
        url: http://standard.sas47-apps.svc.cluster.local:80
        routes:
          - name: standard
            hosts: ["$standard_domain"]
            protocols: [http]
            preserve_host: true
      - name: serverless
        url: http://$kourier_service:80
        connect_timeout: 10000
        read_timeout: 180000
        write_timeout: 180000
        retries: 0
        routes:
          - name: serverless
            hosts: ["$knative_host"]
            protocols: [http]
            preserve_host: true
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: kong
  namespace: sas47-kong
spec:
  replicas: 1
  selector:
    matchLabels: {app: sas47-kong}
  template:
    metadata:
      labels: {app: sas47-kong}
      annotations:
        infra.sasano8.dev/config-sha256: "$config_hash"
    spec:
      automountServiceAccountToken: false
      containers:
        - name: kong
          image: kong:3.9.1
          env:
            - {name: KONG_DATABASE, value: "off"}
            - {name: KONG_DECLARATIVE_CONFIG, value: /etc/kong/config/kong.yml}
            - {name: KONG_PROXY_LISTEN, value: "0.0.0.0:8000"}
            - {name: KONG_ADMIN_LISTEN, value: "off"}
            - {name: KONG_STATUS_LISTEN, value: "0.0.0.0:8100"}
            - {name: KONG_PROXY_ACCESS_LOG, value: /dev/stdout}
            - {name: KONG_PROXY_ERROR_LOG, value: /dev/stderr}
            - {name: KONG_NGINX_WORKER_PROCESSES, value: "1"}
          ports:
            - {name: proxy, containerPort: 8000}
            - {name: status, containerPort: 8100}
          readinessProbe:
            httpGet: {path: /status/ready, port: status}
            initialDelaySeconds: 5
          livenessProbe:
            httpGet: {path: /status, port: status}
            initialDelaySeconds: 30
          resources:
            requests: {cpu: 100m, memory: 256Mi}
            limits: {cpu: "1", memory: 512Mi}
          volumeMounts:
            - {name: config, mountPath: /etc/kong/config, readOnly: true}
      volumes:
        - name: config
          configMap: {name: kong-declarative}
---
apiVersion: v1
kind: Service
metadata:
  name: kong-proxy
  namespace: sas47-kong
spec:
  type: $service_type
  selector: {app: sas47-kong}
  ports:
    - name: http
      port: 80
      targetPort: proxy
$node_port_line
