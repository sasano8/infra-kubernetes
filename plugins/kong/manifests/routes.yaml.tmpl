apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: standard
  namespace: test
  annotations:
$standard_auth
    konghq.com/preserve-host: "true"
    konghq.com/strip-path: "false"
    konghq.com/request-buffering: "$standard_buffering"
    konghq.com/response-buffering: "$standard_buffering"
spec:
  ingressClassName: kong-ingress
$standard_tls
  rules:
    - host: "$standard_host"
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: hello-ssvc
                port: {number: 80}
---
apiVersion: v1
kind: Service
metadata:
  name: kourier-proxy
  namespace: test
  annotations:
    konghq.com/connect-timeout: "10000"
    konghq.com/read-timeout: "180000"
    konghq.com/write-timeout: "180000"
    konghq.com/retries: "0"
spec:
  type: ExternalName
  externalName: "$kourier_service"
  ports:
    - {name: http, port: 80}
---
