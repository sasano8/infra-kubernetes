apiVersion: v1
kind: Service
metadata:
  name: error-service
  namespace: test
  labels: {infra.sasano8.dev/owner: infra-kubernetes}
spec:
  type: ExternalName
  externalName: "$error_service_dns"
  ports:
    - {name: http, port: $error_service_port}
---
apiVersion: networking.internal.knative.dev/v1alpha1
kind: Ingress
metadata:
  name: route-errors
  namespace: test
  labels: {infra.sasano8.dev/owner: infra-kubernetes}
  annotations:
    networking.knative.dev/ingress.class: kourier.ingress.networking.knative.dev
spec:
  httpOption: Enabled
  rules:
    - hosts: $error_knative_hosts
      visibility: ExternalIP
      http:
        paths:
          - path: /
            appendHeaders:
              X-Infra-Error: unknown_host
            splits:
              - serviceName: error-service
                serviceNamespace: test
                servicePort: $error_service_port
                percent: 100
