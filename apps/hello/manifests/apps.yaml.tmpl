apiVersion: apps/v1
kind: Deployment
metadata:
  name: hello-ssvc
  namespace: test
spec:
  replicas: 1
  selector:
    matchLabels: {app: hello-ssvc}
  template:
    metadata:
      labels: {app: hello-ssvc}
    spec:
      automountServiceAccountToken: false
      containers:
        - name: http
          image: ghcr.io/mccutchen/go-httpbin:2.21.0
          env:
            - {name: PORT, value: "8080"}
            - {name: MAX_BODY_SIZE, value: "67108864"}
            - {name: MAX_DURATION, value: "60s"}
            - {name: SRV_READ_TIMEOUT, value: "120s"}
          ports:
            - {name: http, containerPort: 8080}
          readinessProbe:
            httpGet: {path: /get, port: http}
          resources:
            requests: {cpu: 10m, memory: 16Mi}
            limits: {cpu: 100m, memory: 64Mi}
          securityContext:
            allowPrivilegeEscalation: false
            runAsNonRoot: true
            runAsUser: 1000
            capabilities: {drop: [ALL]}
---
apiVersion: v1
kind: Service
metadata:
  name: hello-ssvc
  namespace: test
  annotations:
    konghq.com/read-timeout: "180000"
    konghq.com/write-timeout: "180000"
    konghq.com/retries: "0"
spec:
  selector: {app: hello-ssvc}
  ports:
    - {name: http, port: 80, targetPort: http}
---
apiVersion: serving.knative.dev/v1
kind: Service
metadata:
  name: hello
  namespace: test
  labels:
    infra.sasano8.dev/route: knative_domain
  annotations:
    networking.knative.dev/ingress-class: kourier.ingress.networking.knative.dev
spec:
  template:
    metadata:
      annotations:
        autoscaling.knative.dev/min-scale: "0"
        autoscaling.knative.dev/max-scale: "2"
        autoscaling.knative.dev/window: "30s"
        autoscaling.knative.dev/scale-to-zero-pod-retention-period: "0s"
    spec:
      containerConcurrency: 10
      timeoutSeconds: 120
      containers:
        - name: http
          image: ghcr.io/mccutchen/go-httpbin:2.21.0
          env:
            - {name: MAX_BODY_SIZE, value: "67108864"}
            - {name: MAX_DURATION, value: "60s"}
            - {name: SRV_READ_TIMEOUT, value: "120s"}
          ports:
            - {containerPort: 8080}
          resources:
            requests: {cpu: 10m, memory: 16Mi}
            limits: {cpu: 100m, memory: 64Mi}
---
