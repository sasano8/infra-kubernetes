apiVersion: configuration.konghq.com/v1
kind: KongPlugin
metadata:
  name: strip-error-reason
  namespace: test
  labels: {infra.sasano8.dev/owner: infra-kubernetes}
plugin: request-transformer
# This is the external trust boundary, including when SSO is disabled.
# queue-proxy restores Host from K-Original-Host; clients must never supply it.
# Only Knative's internal hops may generate probe, proxy and revision headers.
# Header-only transforms do not read/buffer an upload body.
config:
  remove:
    headers: [X-Infra-Error, K-Original-Host, K-Proxy-Request, K-Network-Probe, K-Network-Hash, K-Kubelet-Probe, Knative-Serving-Revision, Knative-Serving-Namespace]
---
apiVersion: configuration.konghq.com/v1
kind: KongPlugin
metadata:
  name: routing-error-reason
  namespace: test
  labels: {infra.sasano8.dev/owner: infra-kubernetes}
plugin: request-transformer
config:
  remove:
    headers: [X-Infra-Error, K-Original-Host, K-Proxy-Request, K-Network-Probe, K-Network-Hash, K-Kubelet-Probe, Knative-Serving-Revision, Knative-Serving-Namespace]
  replace:
    headers: ["X-Infra-Error:unknown_host"]
  add:
    headers: ["X-Infra-Error:unknown_host"]
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: standard
  namespace: test
  annotations:
$standard_auth
    konghq.com/preserve-host: "true"
    konghq.com/strip-path: "false"
    konghq.com/request-buffering: "$standard_buffering"
    konghq.com/response-buffering: "$standard_buffering"
spec:
  ingressClassName: kong-ingress
$standard_tls
  rules:
    - host: "$standard_host"
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: hello-ssvc
                port: {number: 80}
---
apiVersion: v1
kind: Service
metadata:
  name: kourier-proxy
  namespace: test
  annotations:
    konghq.com/connect-timeout: "10000"
    konghq.com/read-timeout: "180000"
    konghq.com/write-timeout: "180000"
    konghq.com/retries: "0"
spec:
  type: ExternalName
  externalName: "$kourier_service"
  ports:
    - {name: http, port: 80}
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: hello
  namespace: test
  annotations:
$knative_auth
    konghq.com/preserve-host: "true"
    konghq.com/strip-path: "false"
    konghq.com/request-buffering: "$knative_buffering"
    konghq.com/response-buffering: "$knative_buffering"
spec:
  ingressClassName: kong-ingress
$knative_tls
  rules:
    - host: "$knative_host"
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: kourier-proxy
                port: {number: 80}
---
