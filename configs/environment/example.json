{
  "mode": "new-host",
  "base_domain": "example.test",
  "knative_domain": "knative.example.test",
  "standard_domain": "standard.example.test",
  "kourier_service": "kourier.kourier-system.svc.cluster.local",
  "node_port": null,
  "tls": {
    "enabled": false,
    "email": "",
    "cloudflare_zone": "",
    "cloudflare_token_file": ".local/secrets/cloudflare-api-token",
    "acme_server": "https://acme-v02.api.letsencrypt.org/directory",
    "host_https_port": 443
  },
  "standard_nobuffer_domain": "standard-nobuffer.example.test",
  "knative_nobuffer_domain": "knative-nobuffer.example.test",
  "default_routes": {
    "standard": "standard_domain",
    "knative": "knative_domain"
  },
  "sso": {
    "enabled": false,
    "id_token_routes": [],
    "id_token_header": "X-Forwarded-Id-Token"
  },
  "plugins": {
    "argocd": {
      "enabled": false
    },
    "infisical": {
      "enabled": false
    },
    "external-secrets": {},
    "pinner": {
      "enabled": false
    }
  },
  "knative_public": "knative-public.example.test"
}
