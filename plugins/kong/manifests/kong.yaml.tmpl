apiVersion: apps/v1
kind: Deployment
metadata:
  name: kong
  namespace: sas47-kong
spec:
  replicas: 1
  selector:
    matchLabels: {app: sas47-kong}
  template:
    metadata:
      labels: {app: sas47-kong}
    spec:
      serviceAccountName: sas47-kong
      automountServiceAccountToken: false
      containers:
        - name: kong
          image: kong:3.9.1
          env:
            - {name: KONG_DATABASE, value: "off"}
            - {name: KONG_PROXY_LISTEN, value: "0.0.0.0:8000, 0.0.0.0:8443 ssl"}
            - {name: KONG_PORT_MAPS, value: "80:8000,443:8443"}
            - {name: KONG_ADMIN_LISTEN, value: "127.0.0.1:8001"}
            - {name: KONG_KIC, value: "on"}
            - {name: KONG_STATUS_LISTEN, value: "0.0.0.0:8100"}
            - {name: KONG_PROXY_ACCESS_LOG, value: /dev/stdout}
            - {name: KONG_PROXY_ERROR_LOG, value: /dev/stderr}
            - {name: KONG_NGINX_WORKER_PROCESSES, value: "1"}
          ports:
            - {name: proxy, containerPort: 8000}
            - {name: status, containerPort: 8100}
            - {name: proxy-tls, containerPort: 8443}
          readinessProbe:
            httpGet: {path: /status/ready, port: status}
            initialDelaySeconds: 5
          livenessProbe:
            httpGet: {path: /status, port: status}
            initialDelaySeconds: 30
          resources:
            requests: {cpu: 100m, memory: 256Mi}
            limits: {cpu: "1", memory: 512Mi}
        - name: ingress-controller
          image: kong/kubernetes-ingress-controller:3.4.3
          env:
            - {name: CONTROLLER_KONG_ADMIN_URL, value: "http://127.0.0.1:8001"}
            - {name: CONTROLLER_INGRESS_CLASS, value: sas47-kong}
            - {name: CONTROLLER_WATCH_NAMESPACE, value: "sas47-apps,sas47-kong"}
            - {name: CONTROLLER_PUBLISH_SERVICE, value: sas47-kong/kong-proxy}
            - {name: CONTROLLER_ELECTION_ID, value: sas47-kong}
            - name: POD_NAME
              valueFrom:
                fieldRef: {fieldPath: metadata.name}
            - name: POD_NAMESPACE
              valueFrom:
                fieldRef: {fieldPath: metadata.namespace}
          args:
            - --enable-controller-gwapi-gateway=false
            - --enable-controller-gwapi-httproute=false
            - --enable-controller-gwapi-reference-grant=false
            - --enable-controller-gwapi-grpcroute=false
            - --enable-controller-kong-service-facade=false
          ports:
            - {name: controller, containerPort: 10254}
          readinessProbe:
            httpGet: {path: /readyz, port: controller}
            initialDelaySeconds: 5
          livenessProbe:
            httpGet: {path: /healthz, port: controller}
            initialDelaySeconds: 15
          resources:
            requests: {cpu: 100m, memory: 128Mi}
            limits: {cpu: "1", memory: 512Mi}
          volumeMounts:
            - {name: api-token, mountPath: /var/run/secrets/kubernetes.io/serviceaccount, readOnly: true}
      volumes:
        - name: api-token
          projected:
            sources:
              - serviceAccountToken: {expirationSeconds: 3600, path: token}
              - configMap:
                  name: kube-root-ca.crt
                  items:
                    - {key: ca.crt, path: ca.crt}
              - downwardAPI:
                  items:
                    - path: namespace
                      fieldRef: {fieldPath: metadata.namespace}

---
apiVersion: v1
kind: Service
metadata:
  name: kong-proxy
  namespace: sas47-kong
spec:
  type: $service_type
  selector: {app: sas47-kong}
  ports:
    - name: http
      port: 80
      targetPort: proxy
$node_port_line
    - name: https
      port: 443
      targetPort: proxy-tls
