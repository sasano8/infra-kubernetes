{
  "mode": "new-host",
  "node_port": null,
  "tls": {
    "enabled": false,
    "email": "",
    "cloudflare_zone": "",
    "cloudflare_token_file": ".local/secrets/cloudflare-api-token",
    "acme_server": "https://acme-v02.api.letsencrypt.org/directory",
    "host_https_port": 443
  },
  "sso": {
    "enabled": false,
    "id_token_routes": [],
    "id_token_header": "X-Forwarded-Id-Token"
  },
  "plugins": {
    "argocd": {"enabled": false},
    "infisical": {"enabled": false},
    "external-secrets": {},
    "pinner": {"enabled": false}
  },
  "error_service": {
    "name": "platform-portal",
    "namespace": "test",
    "port": 8080
  },
  "kourier_service": "kourier.kourier-system.svc.cluster.local",
  "base_domain": "example.test",
  "default_routes": {
    "standard": "standard_domain",
    "knative": "knative_domain"
  },
  "routes": {
    "knative_public": {
      "kind": "knative",
      "domain": "knative-public.example.test",
      "auth": "public",
      "buffering": true
    },
    "standard_domain": {
      "kind": "standard",
      "domain": "standard.example.test",
      "auth": "sso",
      "buffering": true
    },
    "standard_nobuffer_domain": {
      "kind": "standard",
      "domain": "standard-nobuffer.example.test",
      "auth": "sso",
      "buffering": false
    },
    "knative_domain": {
      "kind": "knative",
      "domain": "knative.example.test",
      "auth": "sso",
      "buffering": true
    },
    "knative_nobuffer_domain": {
      "kind": "knative",
      "domain": "knative-nobuffer.example.test",
      "auth": "sso",
      "buffering": false
    }
  }
}
